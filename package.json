{
  "name": "dish-my-taste-job",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d && echo 'Postgres on localhost:5434'",
    "db:down": "docker compose down",
    "db:push": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs push",
    "db:pull": "node --env-file=.env.local --import tsx scripts/pull-prod.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "ingest:sirene": "node --env-file=.env.local --import tsx scripts/ingest-sirene.ts",
    "ingest:geocode": "node --env-file=.env.local --import tsx scripts/geocode.ts",
    "plan:cells": "node --env-file=.env.local --import tsx scripts/plan-cells.ts",
    "sweep:google": "node --env-file=.env.local --import tsx scripts/sweep.ts",
    "match:sirene": "node --env-file=.env.local --import tsx scripts/match-sirene.ts",
    "compute:profiles": "node --env-file=.env.local --import tsx scripts/compute-profiles.ts",
    "cron:refresh": "node --env-file=.env.local --import tsx scripts/cron-refresh.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "drizzle-orm": "^0.36.0",
    "next": "^15.0.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.66.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}

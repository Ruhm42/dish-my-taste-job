# Local database (docker compose up).
DATABASE_URL=postgres://dmtj:dmtj@localhost:5434/dmtj

# Supabase: the port picks the pooler, and each consumer needs a different one.
# Supabase dashboard → Project Settings → Database → Connection string
#
# The deployed app (Vercel) uses the TRANSACTION POOLER, port 6543. A serverless
# deployment opens one Postgres backend per function instance; anything else exhausts
# the free tier's connection limit under any concurrency.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# The batch scripts (sweep, cron:refresh, match:sirene, …), locally and in the GitHub
# secret, use the SESSION POOLER: same host, port 5432. The sweep refuses 6543 outright:
# it holds an advisory lock on a reserved connection, and the transaction pooler's
# single-connection pool would then hang every later query. The direct connection
# (db.<ref>.supabase.co) is IPv6-only on the free plan, so GitHub runners cannot reach it.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Google keys: see .specs/technique/08-infrastructure.md ---
# Server only. NEVER a NEXT_PUBLIC_ prefix on this line.
GOOGLE_PLACES_API_KEY=
# Browser. Public by nature: the protection is the HTTP referrer restriction,
# which must list the production domain once Vercel has assigned one.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Supabase Auth ---
# Both are public by design: the publishable key grants nothing on its own, since every
# table has RLS enabled with no policy. Application data goes through DATABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

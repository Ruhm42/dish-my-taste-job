# Local database (docker compose up).
DATABASE_URL=postgres://dmtj:dmtj@localhost:5434/dmtj

# In production, use Supabase's TRANSACTION POOLER (port 6543), not the direct
# connection on 5432. A serverless deployment opens one Postgres backend per function
# instance; the direct connection exhausts the free tier's limit under any concurrency.
# Supabase dashboard → Project Settings → Database → Connection string → Transaction pooler
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Google keys: see .specs/technique/08-infrastructure.md ---
# Server only. NEVER a NEXT_PUBLIC_ prefix on this line.
GOOGLE_PLACES_API_KEY=
# Browser. Public by nature: the protection is the HTTP referrer restriction,
# which must list the production domain once Vercel has assigned one.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Supabase Auth ---
# Both are public by design: the publishable key grants nothing on its own, since every
# table has RLS enabled with no policy. Application data goes through DATABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
